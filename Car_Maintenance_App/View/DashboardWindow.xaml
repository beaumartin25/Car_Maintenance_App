<Window x:Class="Car_Maintenance_App.View.DashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Car_Maintenance_App.View"
        xmlns:vm="clr-namespace:Car_Maintenance_App.ViewModel"
        mc:Ignorable="d"
        Title="DashboardWindow" Height="800" Width="1200">

    <Window.Resources>
        <ResourceDictionary>
            <vm:DashboardVM x:Key="vm"/>
        </ResourceDictionary>
    </Window.Resources>

    <DockPanel DataContext="{StaticResource vm}">
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="File">
                <MenuItem x:Name="newCarMenuItem" Header="New Car" Click="newCarMenuItem_Click"/>
                <MenuItem x:Name="newServiceMenuItem" Header="New Service" Click="newServiceMenuItem_Click"/>
            </MenuItem>
        </Menu>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="5"/>
                <RowDefinition Height="200" MinHeight="50"/>
            </Grid.RowDefinitions>

            <DataGrid ItemsSource="{Binding CarsNeedingService}" AutoGenerateColumns="False" CanUserAddRows="False" SelectedValue="{Binding SelectedCar, Mode=TwoWay}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Make" Binding="{Binding Make}" Width="*"/>
                    <DataGridTextColumn Header="Model" Binding="{Binding Model}" Width="*"/>
                    <DataGridTextColumn Header="Year" Binding="{Binding Year}" Width="*"/>
                    <DataGridTextColumn Header="Mileage" Binding="{Binding Mileage}" Width="*"/>
                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
            <!-- Splitter between Notebooks and Notes -->
            <GridSplitter Grid.Row="1"
              Height="5"
              Background="DarkGray"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Stretch"
              ResizeBehavior="PreviousAndNext"
              ShowsPreview="True"/>
            <Grid Grid.Row="2">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Car Details" FontWeight="Bold" FontSize="16" Margin="10,0,0,0"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="5"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <StackPanel Margin="10">
                                <TextBlock Text="Make:"/>
                                <TextBox Text="{Binding SelectedCar.Make, UpdateSourceTrigger=LostFocus}" Margin="0,0,0,10"/>

                                <TextBlock Text="Model:"/>
                                <TextBox Text="{Binding SelectedCar.Model, UpdateSourceTrigger=LostFocus}" Margin="0,0,0,10"/>

                                <TextBlock Text="Year:"/>
                                <TextBox Text="{Binding SelectedCar.Year, UpdateSourceTrigger=LostFocus}" Margin="0,0,0,10"/>

                                <TextBlock Text="VIN:"/>
                                <TextBox Text="{Binding SelectedCar.VIN, UpdateSourceTrigger=LostFocus}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="10">
                                <TextBlock Text="License Plate:"/>
                                <TextBox Text="{Binding SelectedCar.LicensePlate, UpdateSourceTrigger=LostFocus}" Margin="0,0,0,10"/>

                                <TextBlock Text="Color:"/>
                                <TextBox Text="{Binding SelectedCar.Color, UpdateSourceTrigger=LostFocus}" Margin="0,0,0,10"/>

                                <TextBlock Text="Mileage:"/>
                                <TextBox Text="{Binding SelectedCar.Mileage, UpdateSourceTrigger=LostFocus}" Margin="0,0,0,10"/>

                                <TextBlock Text="Status:"/>
                                <ComboBox ItemsSource="{Binding StatusOptions}"
                                          SelectedItem="{Binding SelectedCar.Status, UpdateSourceTrigger=LostFocus}"/>
                            </StackPanel>
                        </Grid>
                        <Button Content="Update"
                                Command="{Binding UpdateCarCommand}"
                                Width="100"
                                Margin="0,10,0,0" />
                        <TextBlock Text="Services:" FontWeight="Bold" Margin="10,0,10,0"/>
                        <DataGrid ItemsSource="{Binding Services}" AutoGenerateColumns="False" CanUserAddRows="False" Margin="10">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="*"/>
                                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="*"/>
                                <DataGridTextColumn Header="ServiceDate" Binding="{Binding ServiceDate}" Width="*"/>
                                <DataGridTemplateColumn Header="Actions" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="Details" Click="detailsButton_Click"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
